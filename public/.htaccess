# =====================================================================
# File: /www.cominciadaqui.it/public/.htaccess  (rinominare da htaccess-cartella-public.txt)
# Basato sul "Metodo B" della guida ufficiale MoodleDocs "Configuring the Router".
# =====================================================================
DirectoryIndex index.php
Options +FollowSymLinks
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /public/

    # 1. Blocca file e cartelle che non devono essere pubblici
    RewriteRule "(\/vendor\/)" - [F]
    RewriteRule "(\/node_modules\/)" - [F]
    RewriteRule "(^|/)\.(?!well-known\/)" - [F]
    RewriteRule "(composer\.json)" - [F]
    RewriteRule "(\.lock)" - [F]
    RewriteRule "(\/environment.xml)" - [F]
    RewriteRule "(\/install.xml)" - [F]
    RewriteRule "(\/README|\/readme|\/readme_moodle)" - [F]
    RewriteRule "(\/upgrade\.txt|UPGRADING\.md|UPGRADING\-CURRENT\.md)" - [F]
    RewriteRule "(phpunit\.xml\.dist)" - [F]
    RewriteRule "(\/tests\/behat\/)" - [F]
    RewriteRule "(\/fixtures\/)" - [F]

    # 2. Percorsi usati da Moodle per verificare il router
    RewriteRule ^core/check/controller/test$ r.php [QSA,L]
    RewriteRule ^api/rest/v2/openapi.json$ r.php [QSA,L]
    RewriteRule ^lib/exampleshimroute2\.php$ r.php [QSA,L]

    # 3. Se il file o la cartella non esistono, passa la richiesta al router r.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ r.php [QSA,L]
</IfModule>
